rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(id) { return signedIn() && request.auth.uid == id; }
    function member(data) { return signedIn() && request.auth.uid in data.members; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.username == username;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.username == username;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if admin() || (
        me(userId) &&
        request.resource.data.keys().hasOnly([
          'display_name', 'username', 'email', 'bio', 'photo_url',
          'friends_count', 'followers_count', 'following_count',
          'posts_count', 'status_count',
          'fcm_token', 'fcm_updated_at',
          'ugc_terms_accepted', 'ugc_terms_accepted_at'
        ])
      );
      allow update: if admin() || (
        me(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'display_name', 'username', 'email', 'bio', 'photo_url',
          'friends_count', 'followers_count', 'following_count',
          'posts_count', 'status_count',
          'fcm_token', 'fcm_updated_at',
          'ugc_terms_accepted', 'ugc_terms_accepted_at'
        ])
      );
      allow delete: if me(userId) || admin();
      match /friends/{friendId} { allow read, write: if me(userId); }
      match /blocked/{targetId} { allow read, write: if me(userId); }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.author_id == request.auth.uid;
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','comments_count']);
      allow delete: if signedIn() && resource.data.author_id == request.auth.uid;
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.author_id == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.author_id == request.auth.uid;
      }
    }

    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.author_id == request.auth.uid;
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','comments_count']);
      allow delete: if signedIn() && resource.data.author_id == request.auth.uid;
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.author_id == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.author_id == request.auth.uid;
      }
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','responded_at']);
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && member(resource.data);
      allow create: if signedIn() && member(request.resource.data);
      allow update: if signedIn() && member(resource.data) && member(request.resource.data);
      allow delete: if signedIn() && member(resource.data);
      match /messages/{messageId} {
        allow read: if signedIn() && member(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if signedIn() && request.resource.data.sender_id == request.auth.uid && member(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow update, delete: if signedIn() && resource.data.sender_id == request.auth.uid;
      }
    }


    match /group_chats/{groupId} {
      allow read: if signedIn() && member(resource.data);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members && request.resource.data.created_by == request.auth.uid;
      allow update: if signedIn() && member(resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_message','last_message_at','last_sender']) && request.auth.uid in resource.data.members) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active_call']) && request.auth.uid == resource.data.created_by) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ai_enabled','ai_mode']) && request.auth.uid in resource.data.admins)
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.admins;
      match /messages/{messageId} {
        allow read: if signedIn() && member(get(/databases/$(database)/documents/group_chats/$(groupId)).data);
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/group_chats/$(groupId)).data.members && request.resource.data.sender_id == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.sender_id == request.auth.uid;
      }
    }

    match /pending_orders/{orderId} {
      // A signed-in user may create an order only for their own account.
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'pending';
      // Users may read their own order while waiting for approval.
      allow read: if signedIn()
        && (resource.data.user_id == request.auth.uid || admin());
      // Only the server/admin workflow may change payment status.
      allow update, delete: if admin();
    }

    match /admins/{adminId} {
      // Admin membership is provisioned outside the client app.
      allow read: if signedIn() && (request.auth.uid == adminId || admin());
      allow write: if false;
    }

    match /reports/{reportId} { allow create: if signedIn() && request.resource.data.reporter_id == request.auth.uid; allow read, update, delete: if false; }
  }
}
